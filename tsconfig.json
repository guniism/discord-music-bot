{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["*.ts", "db/**/*.ts", "music/**/*.ts", "commands/**/*.ts", "events/**/*.ts"]
}
